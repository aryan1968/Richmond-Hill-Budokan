# Copy this file to .env.local for local development (.env.local is
# git-ignored, so real secrets never get committed). In production, set
# these same names as Environment Variables in the Vercel project settings.
# Full setup walkthrough: docs/PAYMENT-TRACKER-SETUP.md

# Password sensei types in at /admin/login. Pick anything memorable.
ADMIN_PASSWORD=

# Random long string used to sign the login session cookie. Any random
# text works — e.g. generate one with: openssl rand -hex 32
SESSION_SECRET=

# From the Google Cloud service account JSON key file:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# The long ID in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
PAYMENTS_SHEET_ID=
